{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "korean",
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  },
  "permissions": {
    "allow": [
      "Bash(mvn *)",
      "Bash(npm *)",
      "Bash(npx expo *)",
      "Bash(npx expo start *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/node_modules/**)",
      "Read(./**/package-lock.json)",
      "Read(./backend/target/**)",
      "Read(./backend/data/**)",
      "Read(./admin/dist/**)",
      "Read(./mobile/android/**)",
      "Read(./mobile/.expo/**)"
    ]
  }
}
